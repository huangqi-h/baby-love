.seg {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 999rpx;
}

.seg-item.active {
  background: linear-gradient(135deg, #ff9a9e, #ff6b81);
  color: #fff;
  font-weight: 600;
}

.chart-card {
  padding: 20rpx;
  position: relative;
  min-height: 400rpx;
}

.chart-canvas {
  width: 100%;
  height: 480rpx;
}

.chart-empty {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.chart-empty-text {
  font-size: 30rpx;
  color: #bbb;
}

.latest {
  margin: 24rpx 8rpx 0;
  font-size: 28rpx;
  color: #ff6b81;
  font-weight: 600;
}

.hint {
  margin: 16rpx 8rpx 0;
  font-size: 22rpx;
}

.who-line {
  margin: 12rpx 8rpx 0;
  font-size: 24rpx;
  color: #999;
}

.legend {
  display: flex;
  margin: 20rpx 8rpx 0;
  font-size: 22rpx;
  color: #888;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.legend-dot {
  width: 28rpx;
  height: 0;
  margin-right: 10rpx;
}

.legend-dot.solid {
  border-top: 4rpx solid #ff6b81;
}

.legend-dot.dash {
  border-top: 4rpx dashed #c0c0c0;
}

.legend-dot.band {
  width: 28rpx;
  height: 16rpx;
  background: rgba(120, 120, 120, 0.18);
  border-top: 1rpx solid #999;
  border-bottom: 1rpx solid #999;
}
