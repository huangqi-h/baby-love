.seg {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 999rpx;
}

.seg-item.active {
  background: linear-gradient(135deg, #ff9a9e, #ff6b81);
  color: #fff;
  font-weight: 600;
}

.chart-card {
  padding: 20rpx;
  position: relative;
  min-height: 400rpx;
  background: #fff0f1;
}

.chart-canvas {
  width: 100%;
  height: 480rpx;
}

.chart-empty {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.85);
}

.chart-empty-text {
  font-size: 28rpx;
  color: #bbb;
}

.latest {
  margin: 24rpx 8rpx 0;
  font-size: 28rpx;
  color: #ff6b81;
  font-weight: 600;
}

.hint {
  margin: 16rpx 8rpx 0;
  font-size: 22rpx;
}

.who-line {
  margin: 12rpx 8rpx 0;
  font-size: 24rpx;
  color: #999;
}

.legend {
  display: flex;
  margin: 20rpx 8rpx 0;
  font-size: 22rpx;
  color: #888;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.legend-dot {
  width: 28rpx;
  height: 0;
  margin-right: 10rpx;
}

.legend-dot.solid {
  border-top: 4rpx solid #ff6b81;
}

.legend-dot.dash {
  border-top: 4rpx dashed #ffb3b8;
}

.legend-dot.band {
  width: 28rpx;
  height: 16rpx;
  background: rgba(255, 154, 158, 0.28);
  border-top: 1rpx solid #ff9a9e;
  border-bottom: 1rpx solid #ff9a9e;
}

/* 记录列表 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
}

.record-list {
  padding-bottom: 40rpx;
}

.record-group {
  margin-bottom: 24rpx;
}

.group-date {
  font-size: 26rpx;
  color: #999;
  margin: 16rpx 8rpx 12rpx;
}

.group-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.ri-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.ri-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ri-body {
  display: flex;
  flex-direction: column;
}

.ri-type {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 6rpx;
}

.ri-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.ri-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ri-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #eee;
  color: #666;
  background: #fff;
}

.ri-btn.edit {
  color: #4dabf7;
  border-color: #cfe8ff;
}

.ri-btn.delete {
  color: #ff6b81;
  border-color: #ffd0d6;
}
