<view class="container" wx:if="{{record}}">

  <view class="card detail-card">
    <view class="detail-icon" style="background:{{record.typeColor}}1a;color:{{record.typeColor}}">
      {{record.typeIcon}}
    </view>
    <view class="detail-type">{{record.typeLabel}}</view>
    <view class="detail-date text-muted">{{record.dateText}}</view>

    <view wx:if="{{record.isMeasure && record.measureLines.length}}" class="detail-measure">
      <text wx:for="{{record.measureLines}}" wx:key="*this">{{item}}
</text>
    </view>
    <view wx:elif="{{record.note}}" class="detail-note">{{record.note}}</view>

    <view wx:if="{{record.photos.length}}" class="detail-photos">
      <image wx:for="{{record.photos}}" wx:key="*this" class="detail-photo" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-index="{{index}}" />
    </view>
  </view>

  <button class="delete-btn" bindtap="onDelete">删除这条记录</button>
</view>
