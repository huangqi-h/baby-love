.type-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.type-chip {
  flex: 1;
  margin: 0 8rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
}

.type-chip.active {
  color: #fff;
}

.chip-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}

.form-row.column {
  flex-direction: column;
  align-items: stretch;
}

.label {
  font-size: 30rpx;
  color: #444;
  margin-bottom: 12rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

.value-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.value-input {
  text-align: right;
  font-size: 40rpx;
  font-weight: 600;
  color: #ff6b81;
  width: 200rpx;
}

.value-unit {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #999;
}

.note-input {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.save-btn {
  margin-top: 48rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.photo-item, .photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  margin: 0 16rpx 16rpx 0;
  position: relative;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #ccc;
  border: 2rpx dashed #ddd;
}
