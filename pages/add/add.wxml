<view class="container">

  <!-- 类型选择 -->
  <view class="type-row">
    <view
      class="type-chip {{activeType === item.key ? 'active' : ''}}"
      wx:for="{{types}}"
      wx:key="key"
      data-type="{{item.key}}"
      bindtap="onTypeTap"
      style="{{activeType === item.key ? 'background:' + item.color + ';border-color:' + item.color : ''}}">
      <text class="chip-icon">{{item.icon}}</text>
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="card">
    <view class="form-row">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDateChange">
        <view class="picker-value">{{date}}</view>
      </picker>
    </view>

    <!-- 身高/体重输入 -->
    <block wx:if="{{activeType === 'measure' || activeType === 'height' || activeType === 'weight'}}">
      <!-- 编辑旧数据（单条 height/weight）时只显示一个输入框 -->
      <view wx:if="{{isEdit && (activeType === 'height' || activeType === 'weight')}}" class="form-row">
        <text class="label">{{activeType === 'weight' ? '体重' : '身高'}}</text>
        <view class="value-box">
          <input class="value-input" type="digit" placeholder="0" value="{{value}}" bindinput="onValueInput" />
          <text class="value-unit">{{unit}}</text>
        </view>
      </view>

      <!-- 新增 measure 或编辑 measure：同时显示身高+体重 -->
      <block wx:else>
        <view class="form-row">
          <text class="label">身高（可选）</text>
          <view class="value-box">
            <input class="value-input" type="digit" placeholder="0" value="{{heightValue}}" bindinput="onHeightInput" />
            <text class="value-unit">cm</text>
          </view>
        </view>
        <view class="form-row">
          <text class="label">体重（可选）</text>
          <view class="value-box">
            <input class="value-input" type="digit" placeholder="0" value="{{weightValue}}" bindinput="onWeightInput" />
            <text class="value-unit">kg</text>
          </view>
        </view>
      </block>
    </block>

    <!-- 疫苗输入 -->
    <block wx:elif="{{activeType === 'vaccine'}}">
      <view class="form-row">
        <text class="label">疫苗名称</text>
        <picker style="flex:1;text-align:right" bindchange="onVaccineChange" value="{{vaccineIndex}}" range="{{vaccineOptions}}">
          <view class="picker-value" style="color:#333">
            {{vaccineIndex >= 0 ? vaccineOptions[vaccineIndex] : '请选择疫苗'}}
          </view>
        </picker>
      </view>
      <view wx:if="{{vaccineCustom}}" class="form-row">
        <text class="label">自定义名称</text>
        <input class="value-input flex-1" style="text-align:left;color:#333" placeholder="输入疫苗名称" value="{{value}}" bindinput="onValueInput" />
      </view>
      <view class="form-row column">
        <text class="label">备注（可选）</text>
        <textarea class="note-input" placeholder="记录批号、接种部位等…" value="{{note}}" bindinput="onNoteInput" maxlength="500" />
      </view>
    </block>

    <!-- 日记/里程碑：文本输入 -->
    <view wx:else class="form-row column">
      <text class="label">{{activeType === 'milestone' ? '发生了什么' : '今天想说'}}</text>
      <textarea class="note-input" placeholder="记录美好瞬间…" value="{{note}}" bindinput="onNoteInput" maxlength="500" />
    </view>

    <!-- 照片（可选） -->
    <view class="form-row column photo-row">
      <text class="label">照片（可选）</text>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="*this" data-index="{{index}}" bindtap="onRemovePhoto">
          <image class="photo-img" src="{{item}}" mode="aspectFill" />
          <view class="photo-del">×</view>
        </view>
        <view wx:if="{{photos.length < 9}}" class="photo-add" bindtap="onChoosePhoto">＋</view>
      </view>
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="onSave">{{isEdit ? '保存修改' : '保存记录'}}</button>
</view>
