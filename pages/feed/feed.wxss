.feed-info {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 8rpx 20rpx;
  font-size: 26rpx;
  color: #ff6b81;
}

.type-row {
  display: flex;
  margin-bottom: 16rpx;
}

.type-chip {
  flex: 1;
  margin: 0 8rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

.type-chip.active {
  background: #ff6b81;
  color: #fff;
  border-color: #ff6b81;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #444;
}

.value-box {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.value-input {
  text-align: right;
  font-size: 36rpx;
  font-weight: 600;
  color: #ff6b81;
  width: 160rpx;
}

.value-unit {
  margin-left: 12rpx;
  color: #999;
  font-size: 28rpx;
}

.save-btn {
  margin-top: 40rpx;
}

.feed-list {
  margin-top: 24rpx;
}

.feed-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}

.feed-time {
  font-size: 26rpx;
  color: #999;
  width: 220rpx;
}

.feed-desc {
  flex: 1;
  font-size: 28rpx;
  color: #444;
}

.feed-del {
  color: #ccc;
  font-size: 28rpx;
}
