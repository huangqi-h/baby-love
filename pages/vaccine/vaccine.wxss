.section-title {
  margin: 8rpx 8rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
}

.vac-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #ddd;
}

.vac-item.done {
  opacity: 0.6;
  border-left-color: #51cf66;
}

.vac-item.soon {
  border-left-color: #ffa94d;
}

.vac-item.overdue {
  border-left-color: #ff6b81;
}

.vac-main {
  flex: 1;
}

.vac-name {
  font-size: 30rpx;
  color: #333;
}

.vac-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.vac-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  color: #888;
}

.vac-status.soon {
  background: #fff3e0;
  color: #ffa94d;
}

.vac-status.overdue {
  background: #ffe3e8;
  color: #ff6b81;
}

.vac-check {
  margin-left: 16rpx;
  font-size: 40rpx;
  color: #4dabf7;
}

.sub-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7f8;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.sub-tip {
  font-size: 24rpx;
  color: #b07a82;
  flex: 1;
}

.sub-btn {
  background: linear-gradient(135deg, #ff9a9e, #ff6b81);
  color: #fff;
  font-size: 24rpx;
  margin: 0;
  padding: 0 28rpx;
  line-height: 56rpx;
}

.sub-btn::after {
  border: none;
}

/* 自定义疫苗记录 */
.vac-record {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.vac-rec-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vac-rec-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.vac-rec-date {
  font-size: 24rpx;
  color: #999;
}

.vac-rec-note {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
}

/* 接种日期选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}

.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 40rpx 60rpx;
  box-sizing: border-box;
  animation: slideUp 0.25s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-label {
  font-size: 30rpx;
  color: #555;
}

.picker-val {
  font-size: 30rpx;
  color: #ff6b81;
  font-weight: 500;
}

.picker-btns {
  display: flex;
  margin-top: 40rpx;
  gap: 24rpx;
}

.picker-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.picker-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.picker-btn.confirm {
  background: linear-gradient(135deg, #ff9a9e, #ff6b81);
  color: #fff;
}
