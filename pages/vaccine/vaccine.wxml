<view class="container">

  <view wx:if="{{!babyName}}" class="empty-box">
    <view class="empty-emoji">💉</view>
    <view class="empty-text">请先在首页添加宝宝</view>
  </view>

  <block wx:else>
    <view class="section-title">{{babyName}} 的疫苗接种计划</view>
    <view class="sub-bar">
      <text class="sub-tip">临近/逾期疫苗可开启微信提醒</text>
      <button class="sub-btn" size="mini" bindtap="onSubscribe">{{subscribed ? '已开启提醒' : '开启提醒'}}</button>
    </view>
    <view class="vac-item {{item.isDone ? 'done' : ''}} {{item.status}}" wx:for="{{list}}" wx:key="id" bindtap="onTapItem" data-id="{{item.id}}">
      <view class="vac-main">
        <view class="vac-name">{{item.name}}</view>
        <view class="vac-sub">{{item.dueText}} · {{item.diffText}}</view>
      </view>
      <text wx:if="{{item.isDone}}" class="vac-check">✓</text>
      <view wx:else class="vac-status {{item.status}}">{{item.status === 'overdue' ? '逾期' : (item.status === 'soon' ? '临近' : '待接种')}}</view>
    </view>

    <!-- 自定义疫苗接种记录 -->
    <view class="section-title" style="margin-top:40rpx">已记录接种</view>
    <view wx:if="{{!customVaccines.length}}" class="empty-sub" style="text-align:center;padding:40rpx 0">还没有手动记录的疫苗接种</view>
    <view class="card vac-record" wx:for="{{customVaccines}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="vac-rec-main">
        <view class="vac-rec-name">{{item.name}}</view>
        <view class="vac-rec-date">{{item.dateText}}</view>
      </view>
      <view wx:if="{{item.note}}" class="vac-rec-note">{{item.note}}</view>
    </view>
  </block>

  <!-- 接种日期选择弹窗 -->
  <view wx:if="{{showPicker}}" class="picker-mask" bindtap="onPickerCancel">
    <view class="picker-panel" catchtap="noop">
      <view class="picker-title">记录「{{pickerName}}」接种</view>
      <view class="picker-row">
        <text class="picker-label">接种日期</text>
        <picker mode="date" value="{{pickerDate}}" end="{{today}}" bindchange="onPickerChange">
          <view class="picker-val">{{pickerDate}}</view>
        </picker>
      </view>
      <view class="picker-btns">
        <view class="picker-btn cancel" bindtap="onPickerCancel">取消</view>
        <view class="picker-btn confirm" bindtap="onPickerConfirm">确认</view>
      </view>
    </view>
  </view>
</view>
