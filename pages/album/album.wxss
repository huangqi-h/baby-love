.empty-box {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 20rpx;
  color: #aaa;
  font-size: 26rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.photo-item {
  position: relative;
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f7f7f7;
}

.photo-img {
  width: 100%;
  height: 220rpx;
  display: block;
}

.photo-meta {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 10rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.photo-type, .photo-date {
  font-size: 20rpx;
  color: #fff;
}
