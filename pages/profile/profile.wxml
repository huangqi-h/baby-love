<view class="container">

  <view class="me-card">
    <view wx:if="{{baby}}" class="me-top">
      <image wx:if="{{baby.isImgAvatar}}" class="me-avatar-img" src="{{baby.avatar}}" mode="aspectFill" />
      <view wx:else class="me-avatar">{{baby.avatar || '👶'}}</view>
      <view class="me-info">
        <view class="me-name">{{baby.name}}</view>
        <view class="me-sub">{{ageText}} · 共 {{babyCount}} 个宝宝</view>
      </view>
    </view>
    <view wx:else class="me-empty">还没有宝宝，去「宝宝管理」添加吧～</view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="goBabies">
      <text class="mi-icon">👶</text><text class="mi-text">宝宝管理</text><text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goVaccine">
      <text class="mi-icon">💉</text><text class="mi-text">疫苗提醒</text><text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFeed">
      <text class="mi-icon">🍼</text><text class="mi-text">喂养记录</text><text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goTodo">
      <text class="mi-icon">✅</text><text class="mi-text">待办事项</text><text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goBackup">
      <text class="mi-icon">☁️</text><text class="mi-text">数据备份</text><text class="mi-arrow">›</text>
    </view>
  </view>

  <view class="menu card">
    <view wx:if="{{!shareId}}">
      <view class="menu-item" bindtap="createShare">
        <text class="mi-icon">🔗</text><text class="mi-text">开启家庭共享</text><text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showJoinInput">
        <text class="mi-icon">🚪</text><text class="mi-text">加入家庭</text><text class="mi-arrow">›</text>
      </view>
    </view>
    <view wx:else>
      <view class="share-bar">
        <text class="share-label">当前家庭码</text>
        <text class="share-code">{{shareId}}</text>
      </view>
      <view class="share-bar">
        <text class="share-label">家庭成员</text>
        <text class="share-code">{{memberCount}} 人 {{isOwner ? '(创建者)' : ''}}</text>
      </view>
      <view class="menu-item" bindtap="syncNow">
        <text class="mi-icon">🔄</text><text class="mi-text">立即同步</text><text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="exitShare">
        <text class="mi-icon">❌</text><text class="mi-text">退出家庭共享</text><text class="mi-arrow">›</text>
      </view>
    </view>
  </view>
</view>
