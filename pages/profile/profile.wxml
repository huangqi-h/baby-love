<view class="container">

  <view class="card">
    <view class="form-row">
      <text class="label">宝宝名字</text>
      <input class="input" placeholder="如：小汤圆" value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="form-row">
      <text class="label">性别</text>
      <radio-group class="radio-group" bindchange="onGenderChange">
        <label class="radio-item"><radio value="boy" checked="{{gender === 'boy'}}" color="#ff6b81" />小王子</label>
        <label class="radio-item"><radio value="girl" checked="{{gender === 'girl'}}" color="#ff6b81" />小公主</label>
      </radio-group>
    </view>

    <view class="form-row">
      <text class="label">出生日期</text>
      <picker mode="date" value="{{birthday}}" end="{{maxBirthday}}" bindchange="onBirthdayChange">
        <view class="picker-value">{{birthday || '请选择'}}</view>
      </picker>
    </view>

    <view class="form-block">
      <text class="label">选择一个头像</text>
      <view class="avatar-list">
        <view
          class="avatar-opt {{avatar === item ? 'active' : ''}}"
          wx:for="{{avatars}}"
          wx:key="*this"
          data-avatar="{{item}}"
          bindtap="onAvatarTap">{{item}}</view>
      </view>
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="onSave">保存</button>
</view>
