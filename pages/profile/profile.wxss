.me-card {
  background: linear-gradient(135deg, #ffd3d8, #ffb3c0);
  border-radius: 28rpx;
  padding: 40rpx;
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(255, 107, 129, 0.25);
}

.me-top {
  display: flex;
  align-items: center;
}

.me-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.me-info {
  margin-left: 24rpx;
}

.me-name {
  font-size: 40rpx;
  font-weight: 600;
}

.me-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.me-empty {
  font-size: 30rpx;
  opacity: 0.9;
}

.menu {
  margin-top: 32rpx;
  padding: 8rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.mi-text {
  flex: 1;
  font-size: 30rpx;
  color: #444;
}

.mi-arrow {
  color: #ccc;
  font-size: 40rpx;
}
